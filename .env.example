DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dorismon
REDIS_URL=memory://
# PRODUCCIÓN: una clave ALEATORIA de al menos 32 caracteres. El valor de ejemplo de abajo (o el fallback del
# código) hace que el servicio NO arranque en producción (Render / ENVIRONMENT=production).
SECRET_KEY=cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BOOKING_HOLD_MINUTES=5
DEFAULT_TIMEZONE=America/Santo_Domingo

# --- v3.9.76: seguridad (ver PENDIENTES_DEPLOY.md) ---
# Render define RENDER=true solo. Fuera de Render, para activar el modo producción:
# ENVIRONMENT=production
# Render define RENDER=true y el rate limiter usa CF-Connecting-IP; NO configurar TRUSTED_PROXY_COUNT en Render.
# Solo para infraestructura NO-Render con proxies administrados por ti: número de saltos confiables de X-Forwarded-For.
# TRUSTED_PROXY_COUNT=1
# Lista EXACTA de orígenes del frontend (sin comodín). Si falta, en producción se usan solo los dominios de Dorismon.
# CORS_ORIGINS=https://dorismon.com,https://www.dorismon.com
# Previews de Vercel (solo QA): por defecto cerrados.
# ALLOW_VERCEL_PREVIEWS=false
# NO definir en producción salvo una limpieza de lanzamiento deliberada (habilita el borrado operativo; retirar después).
# ALLOW_DESTRUCTIVE_MAINTENANCE=true
# Solo desarrollo: el seed exige ALLOW_DEV_SEED=true y las tres contraseñas (no trae ninguna; en producción no corre).
# ALLOW_DEV_SEED=true
# SEED_ADMIN_PASSWORD=
# SEED_TEACHER_PASSWORD=
# SEED_STUDENT_PASSWORD=
